Sun Nov 23 11:44:26 PM UTC 2025
$SIZES      LIM6=4000 LTH=-1000 DIMNEW=-10000
$PROBLEM   
$INPUT      ID TIME DAY ITEM DV
$DATA      Analysis_Data_nm.csv IGNORE=@
$PRED
;-------------------------constants to select model type-------------------------
PSI_MODEL=0
UNDEF=0
OC1=1    ; ordered categorical [1,4]

;-------------------------assignment of item parameters--------------------------
IF(ITEM.EQ.1) THEN
    MODEL=OC1
    DIS=THETA(1)
    DIF1=THETA(2)
    DIF2=THETA(3)
    DIF3=THETA(4)
ELSE IF(ITEM.EQ.2) THEN
    MODEL=OC1
    DIS=THETA(5)
    DIF1=THETA(6)
    DIF2=THETA(7)
    DIF3=THETA(8)
ELSE IF(ITEM.EQ.3) THEN
    MODEL=OC1
